  {
   "id": "policy-audit-log",
   "kind": "note",
   "domain": "governance",
   "risk_tier": "2",
   "text": "Every agent action is written to a hash chained audit log. Each entry includes the hash of the previous entry so tampering is detectable. Audit entries are scoped by tenant."
  },
  {
   "id": "policy-cold-chain",
   "kind": "note",
   "domain": "operations",
   "risk_tier": "2",
   "text": "Cold chain products must be stored between 2 and 8 degrees Celsius. Any temperature excursion must be recorded within one hour. The required response to an excursion depends on the risk class of the SKU, see policy-excursion-response and policy-lot-hold."
  },
  {
   "id": "policy-excursion-response",
   "kind": "note",
   "domain": "quality",
   "risk_tier": "3",
   "text": "After a temperature excursion, risk class A SKUs require you to place an immediate lot hold and notify the quality lead. Risk class B SKUs require you to open a quality review within 24 hours. Risk class C SKUs require you to log the excursion with no further action."
  },
  {
   "id": "policy-expiry",
   "kind": "note",
   "domain": "operations",
   "risk_tier": "1",
   "text": "Products within 30 days of expiry are flagged for priority shipping. Expired products must be quarantined, see policy-quarantine."
  },
  {
   "id": "policy-hitl-approval",
   "kind": "note",
   "domain": "governance",
   "risk_tier": "3",
   "text": "Tier 3 actions such as lot holds and SKU status changes are never executed automatically. They are written as PENDING_APPROVAL and wait for a reviewer to approve or reject. Reviewers must not approve their own requests."
  },
  {
   "id": "policy-labeling",
   "kind": "note",
   "domain": "operations",
   "risk_tier": "1",
   "text": "Every unit carries a label with SKU, lot number and expiry date. Labels for cold chain products also show the storage temperature range."
  },
  {
   "id": "policy-lot-hold",
   "kind": "note",
   "domain": "quality",
   "risk_tier": "3",
   "text": "A lot hold freezes shipment of a lot. Placing a lot hold is a Tier 3 mutation and needs human approval from an authorized reviewer, see policy-hitl-approval. Lot identifiers use the format LOT-00000 with five digits."
  },
  {
   "id": "policy-pii",
   "kind": "note",
   "domain": "governance",
   "risk_tier": "2",
   "text": "Personal data such as email addresses, phone numbers and social security numbers must be redacted before storage. Raw personal data is never written to logs, caches or audit records. See policy-audit-log."
  },
  {
   "id": "policy-quarantine",
   "kind": "note",
   "domain": "quality",
   "risk_tier": "2",
   "text": "Quarantined stock is physically segregated and labeled QUARANTINE. Release from quarantine requires a quality review."
  },
  {
   "id": "policy-recall",
   "kind": "note",
   "domain": "quality",
   "risk_tier": "3",
   "text": "A recall is initiated by the quality lead after a confirmed safety defect. All lots of the affected SKU are placed on hold, see policy-lot-hold, and customers are notified within 48 hours."
  },
  {
   "id": "policy-returns",
   "kind": "note",
   "domain": "sales",
   "risk_tier": "1",
   "text": "Customer returns are accepted within 30 days of delivery when the seal is intact. Returned cold chain products are never restocked."
  },
  {
   "id": "policy-supplier-audit",
   "kind": "note",
   "domain": "procurement",
   "risk_tier": "1",
   "text": "Critical suppliers are audited every 12 months. Non critical suppliers are audited every 24 months."
  },
